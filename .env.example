# ============================================
# PRIVY CONFIGURATION (REQUIRED)
# ============================================
# Get your Privy App ID from https://dashboard.privy.io/
REACT_APP_PRIVY_APP_ID=your_privy_app_id_here

# Optional: Custom logo URL for Privy login screen
REACT_APP_PRIVY_LOGO_URL=https://your-logo-url.com/logo.png

# Privy appearance settings
REACT_APP_PRIVY_THEME=light
REACT_APP_PRIVY_ACCENT_COLOR=#676FFF


# ============================================
# CAPACITOR CONFIGURATION
# ============================================
# App Bundle ID (reverse domain notation)
# Change this to your own app ID before publishing
# Format: com.yourcompany.yourapp
REACT_APP_CAPACITOR_APP_ID=io.ionic.starter

# App display name
REACT_APP_CAPACITOR_APP_NAME=my-solana-sdk


# ============================================
# SOLANA NETWORK CONFIGURATION
# ============================================
# Network selection
# Options: mainnet-beta, testnet, devnet
REACT_APP_SOLANA_NETWORK=devnet

# Optional: Custom RPC Endpoint
# Leave empty to use default public endpoints
# For production, use a dedicated RPC provider:
# - QuickNode: https://www.quicknode.com/
# - Alchemy: https://www.alchemy.com/
# - Helius: https://helius.xyz/
REACT_APP_SOLANA_RPC_ENDPOINT=

# Optional: Solana Explorer
# Options: solana, solscan, solanabeach
REACT_APP_SOLANA_EXPLORER=solscan


# ============================================
# LAUNCHPAD API CONFIGURATION
# ============================================
# Launch.meme API Base URL
REACT_APP_LAUNCHPAD_API_URL=https://launch.meme/api/

# WebSocket URL for real-time updates
REACT_APP_LAUNCHPAD_WS_URL=wss://launch.meme/connection/websocket

# Centrifuge API Key (REQUIRED for WebSocket - get from client)
# NEVER commit this to git!
REACT_APP_CENTRIFUGE_KEY=your_centrifuge_key_here

# Mock Mode (set to true for development without API access)
REACT_APP_LAUNCHPAD_USE_MOCK=true

# WebSocket Reconnection Settings
REACT_APP_WS_RECONNECT_DELAY=1000
REACT_APP_WS_MAX_RECONNECT_ATTEMPTS=5

# API Request Settings
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3
