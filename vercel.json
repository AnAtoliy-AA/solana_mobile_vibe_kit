{
  "buildCommand": "DISABLE_ESLINT_PLUGIN=true PUBLIC_URL=/ REACT_APP_PROXY_URL=/api npm run build",
  "devCommand": "npm start",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://launch.meme/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
